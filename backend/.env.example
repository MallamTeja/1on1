# =============================================================================
# 1on1 — environment variables
# =============================================================================
#
# HOW TO USE THIS FILE
#   Copy it to the REPO ROOT (not into backend/) and name it ".env":
#
#       cp backend/.env.example .env
#
#   There is ONE .env for the whole monorepo. backend/src/config/loadEnv.js
#   resolves it as <repo root>/.env, and frontend/vite.config.js sets
#   `envDir: '../'` so Vite reads the same file. One source of truth, no drift.
#
#   The root .env is gitignored. THIS file is not — so it must never contain a
#   real value. Placeholders only.
#
#   VITE_ PREFIX WARNING: Vite exposes any variable starting with VITE_ to the
#   browser bundle, where it is world-readable. Nothing below is prefixed, and
#   nothing below should ever be renamed to add one.
#
# WHAT YOU ACTUALLY NEED TO SET
#   Nothing, to boot. Every value has a working development default, and the
#   server starts on a fresh clone with no .env at all.
#   To keep sessions alive across restarts:   JWT_ACCESS_SECRET
#   To make the "Continue with Google" button work:
#                                             GOOGLE_OAUTH_CLIENT_ID
#                                             GOOGLE_OAUTH_CLIENT_SECRET
# =============================================================================


# --- Core -------------------------------------------------------------------

# TCP port for the Express server. Must match the proxy target in
# frontend/vite.config.js, which is hardcoded to http://localhost:5000.
PORT=5000

# "development" or "production". Controls cookie Secure flags, whether stack
# traces appear in error responses, and whether the in-memory user store is
# allowed to load at all (it refuses in production, by design).
NODE_ENV=development


# --- Access token signing ----------------------------------------------------

# Secret used to sign short-lived JWT access tokens (HS256).
#
# If unset in development the server generates a random one per process and
# prints a warning — which means every restart invalidates every token and logs
# you out. Set it to stop that. In production a missing value is fatal.
#
# Generate a real one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string

# How long an access token stays valid. Short on purpose: it cannot be revoked
# before it expires, so its lifetime IS its blast radius. 900s = 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900

# How long the HTTP-only refresh cookie lasts. This is how long someone stays
# signed in without re-entering a password.
REFRESH_TOKEN_TTL_DAYS=30


# --- Browser origins ---------------------------------------------------------

# Comma-separated list of origins allowed to make credentialed calls to this
# API. A SECURITY BOUNDARY: any origin here can act as a signed-in user, because
# the browser attaches the refresh cookie automatically.
#
# "*" is not an option — browsers refuse to combine a wildcard origin with
# credentialed requests, and every call in frontend/src/lib/api.ts is
# credentialed. Add the real frontend domain here before deploying.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Where the Google callback sends the browser once the session cookie is set.
FRONTEND_URL=http://localhost:3000


# --- Cookie flags (optional; sensible defaults come from NODE_ENV) -----------

# Send cookies over HTTPS only. Defaults to true in production, false otherwise.
# Must be false for local http://localhost or the browser silently drops them.
# COOKIE_SECURE=false

# "lax" is correct while the frontend and API share a site (the Vite proxy in
# dev, one domain in production). Split the API onto its own domain — say
# api.example.com serving app.example.com — and this must become "none", which
# browsers only honour together with COOKIE_SECURE=true.
# COOKIE_SAMESITE=lax


# --- Google Sign-In (optional) -----------------------------------------------
#
# Google is used here ONLY as an identity provider. This does not put any part
# of the app on Google Cloud — hosting stays AWS-only. There is no GCP SDK, no
# Firebase and no Google client library in this backend; the flow is a redirect,
# one HTTPS POST and a signature check, all in src/services/googleOAuth.js.
#
# Leave these blank and everything else still works: the two Google routes
# answer 503 and email+password auth is unaffected.
#
# WHERE TO GET THESE
#   console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create Credentials -> OAuth client ID -> Web application
#   Under "Authorized redirect URIs" add EXACTLY the value of
#   GOOGLE_OAUTH_REDIRECT_URI below. Google string-compares it, so a trailing
#   slash or http-vs-https difference produces redirect_uri_mismatch.
#   You will also need an OAuth consent screen with the scopes
#   openid / email / profile.
#
# The client secret is a real credential. Never commit it, never log it, never
# put it in frontend code.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must match a redirect URI registered in the Google console byte for byte.
# In production this becomes https://<your-api-domain>/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
